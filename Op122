--================================
-- ESP
--================================

local function createESP(other)
	if other == player or highlights[other] then
		return
	end

	local h = Instance.new("Highlight")
	h.Name = "BlueESP"
	h.FillColor = Color3.fromRGB(0,170,255)
	h.OutlineColor = Color3.fromRGB(0,100,255)
	h.FillTransparency = .65
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Enabled = espEnabled
	h.Parent = gui

	highlights[other] = h

	local function update()
		h.Adornee = other.Character
	end

	update()

	other.CharacterAdded:Connect(function()
		task.wait()
		update()
	end)
end

for _, p in ipairs(Players:GetPlayers()) do
	createESP(p)
end

Players.PlayerAdded:Connect(createESP)

Players.PlayerRemoving:Connect(function(p)
	if highlights[p] then
		highlights[p]:Destroy()
		highlights[p] = nil
	end
end)

local function updateESP()
	for _, h in pairs(highlights) do
		h.Enabled = espEnabled
	end
end

--================================
-- TARGET
--================================

local function findTarget()
	local best
	local bestDistance = math.huge

	local center = Vector2.new(
		camera.ViewportSize.X/2,
		camera.ViewportSize.Y/2
	)

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then

			local humanoid =
				p.Character:FindFirstChildOfClass("Humanoid")

			local part =
				p.Character:FindFirstChild(aimPart)

			if humanoid and part and humanoid.Health > 0 then

				local screen, visible =
					camera:WorldToViewportPoint(part.Position)

				local distance =
					(camera.CFrame.Position-part.Position).Magnitude

				if visible
					and screen.Z > 0
					and distance <= maxDistance then

					local screenDistance =
						(Vector2.new(screen.X,screen.Y)-center).Magnitude

					if screenDistance <= fovSize/2
						and screenDistance < bestDistance then

						bestDistance = screenDistance
						best = p
					end
				end
			end
		end
	end

	return best
end

--================================
-- AIM
--================================

RunService.RenderStepped:Connect(function()

	updateESP()

	if not aimEnabled then
		target = nil
		return
	end

	target = findTarget()

	if target and target.Character then

		local part =
			target.Character:FindFirstChild(aimPart)

		if part then

			local desired =
				CFrame.lookAt(
					camera.CFrame.Position,
					part.Position
				)

			camera.CFrame =
				camera.CFrame:Lerp(
					desired,
					smoothness
				)
		end
	end
end)

--================================
-- BUTTONS
--================================

aimButton.Activated:Connect(function()
	aimEnabled = not aimEnabled

	aimButton.Text =
		aimEnabled and "AIM : ON" or "AIM : OFF"
end)

espButton.Activated:Connect(function()
	espEnabled = not espEnabled
	updateESP()

	espButton.Text =
