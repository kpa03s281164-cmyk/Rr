end)

pickupButton.Activated:Connect(function()
	instantPickup = not instantPickup

	pickupButton.Text =
		instantPickup and "PICKUP : ON" or "PICKUP : OFF"
end)

minus.Activated:Connect(function()
	fovSize = math.max(50,fovSize-25)
	fovLabel.Text = "FOV : "..fovSize
	circle.Size = UDim2.fromOffset(fovSize,fovSize)
end)

plus.Activated:Connect(function()
	fovSize = math.min(500,fovSize+25)
	fovLabel.Text = "FOV : "..fovSize
	circle.Size = UDim2.fromOffset(fovSize,fovSize)
end)

--================================
-- DRAG MENU
--================================

local dragging = false
local dragStart
local startPos

menu.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = menu.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)

	if not dragging then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position-dragStart

		menu.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset+delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset+delta.Y
		)
	end
end)
