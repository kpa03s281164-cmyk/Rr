        local PosX = SliderBg.AbsolutePosition.X
        local Wid = SliderBg.AbsoluteSize.X
        local Perc = math.clamp(((Input.Position.X - PosX)/Wid)*100,5,100)
        Settings.FOV=math.floor(Perc)
        FOVLabel.Text="FOV: "..Settings.FOV.."%"
        SliderFill.Size=UDim2.new(Perc/100,0,1,0)
        SliderKnob.Position=UDim2.new(Perc/100, -7, -0.3,0)
    end
end)
UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then DragFOV=false end end)

-- ✅ ตรวจสายตาไม่ทะลุกำแพง
local function HasLineOfSight(From, To)
    if not Settings.BlockCheck then return true end
    local Ray = Ray.new(From, (To-From).Unit*((To-From).Magnitude-4))
    local Hit = Workspace:FindPartOnRayWithIgnoreList(Ray, {LocalPlr.Character}, false, true)
    return Hit==nil
end

-- ✅ หาผู้เล่นใกล้+อยู่ในFOV+เห็นชัด
local function GetNearestPlayer()
    local Char=LocalPlr.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return nil end
    local Root=Char.HumanoidRootPart
    local Best,MinDist=nil,Settings.SearchRadius
    for _,P in ipairs(Players:GetPlayers())do
        if P~=LocalPlr and P.Character and P.Character:FindFirstChild("HumanoidRootPart") then
            local PRoot=P.Character.HumanoidRootPart
            local Vec=Camera:WorldToViewportPoint(PRoot.Position)
            if Vec.Z>0 then
                local OnScreen=(Vector2.new(Vec.X,Vec.Y)-Gui.AbsoluteSize/2).Magnitude <= (Settings.FOV/100)*280
                local Dist=(Root.Position-PRoot.Position).Magnitude
                if Dist<MinDist and HasLineOfSight(Root.Position,PRoot.Position) and OnScreen then
                    MinDist=Dist; Best=P.Character
                end
            end
        end
    end
    return Best
end

-- ✅ วงล็อกสีฟ้า
local function SetRing(Tar)
    if Ring then Ring.Parent=nil end; if RingConn then RingConn:Disconnect() end
    if not Tar then return end
    local AimPart=Tar:FindFirstChild("Head") or Tar.HumanoidRootPart
    Ring=Instance.new("Part")
    Ring.Name="TargetRing"
    Ring.Shape=Enum.PartType.Cylinder
    Ring.Size=Vector3.new(0.25,2.4,2.4)
    Ring.Color=Color3.fromRGB(0,190,255)
    Ring.Material=Enum.Material.Neon
    Ring.Transparency=0.25
    Ring.Anchored=true;Ring.CanCollide=false;Ring.CastShadow=false
    Ring.Parent=Workspace

    RingConn=RunService.RenderStepped:Connect(function()
        if not Tar or Tar.Humanoid.Health<=0 or not AimPart then RingConn:Disconnect();Ring.Parent=nil;return end
        local Pos=AimPart.Position+Vector3.new(0,1.2,0)
        Ring.CFrame=CFrame.new(Pos,Pos+(Camera.CFrame.Position-Pos).Unit*2)*CFrame.Angles(math.rad(90),0,0)
    end)
end

-- ✅ ล็อกหลัก
ToggleBtn.MouseButton1Click:Connect(function()
    Enabled=not Enabled
    ToggleBtn.BackgroundColor3=Enabled and Color3.fromRGB(0,140,230) or Color3.fromRGB(80,80,100)
    ToggleBtn.Text=Enabled and "ON" or "OFF"
    if not Enabled then CurrentTarget=nil;if Ring then Ring.Parent=nil end end
end)

local function Lock()
    if not Enabled then return end
    CurrentTarget=GetNearestPlayer()
    if CurrentTarget then
        SetRing(CurrentTarget)
        ToggleBtn.Text="✅ ล็อก:"..CurrentTarget.Name
    else
        ToggleBtn.Text="❌ ไม่เจอเป้า"
        if Ring then Ring.Parent=nil end
        task.delay(1.2,function() ToggleBtn.Text=Enabled and "ON" or "OFF" end)
    end
end

-- ปุ่มลัด
UIS.InputBegan:Connect(function(i,p) if not p and i.KeyCode==Settings.KeyBind then Lock() end end)
