-- ⚙️ การตั้งค่าเริ่มต้น
local Settings = {
    MenuPosition = {X = 150, Y = 100}, -- ตำแหน่งเริ่มต้นเมนู
    MenuSize = {W = 140, H = 70},      -- ขนาดเมนูเล็ก
    Enabled = true,                     -- สถานะเริ่มต้นเปิด
    KeyBind = Enum.KeyCode.F,           -- ปุ่มกดใช้สกิล/ล็อกเป้า
    SearchRadius = 300,                -- ระยะค้นหา NPC
}

-- 🧱 สร้างเมนูที่ลากได้
local CoreGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
local UI = Instance.new("ScreenGui", CoreGui)
UI.Name = "NPC_Lock_System"
