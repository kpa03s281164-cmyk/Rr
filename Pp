-- ✅ ตรวจสายตา — ไม่ทะลุกำแพง
local function HasLineOfSight(From, To)
    if not Settings.BlockCheck then return true end
    local Ray = Ray.new(From, (To - From).Unit * ((To - From).Magnitude - Settings.BlockDist))
    local Hit = Workspace:FindPartOnRayWithIgnoreList(Ray, {LocalPlr.Character}, false, true)
    return Hit == nil
end

-- 🧠 หาผู้เล่นที่ใกล้ที่สุด + ต้องเห็นด้วย
local function GetNearestPlayer()
    local Char = LocalPlr.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return nil end
    local Root = Char.HumanoidRootPart
    local Best, MinDist = nil, Settings.SearchRadius

    for _,Plr in ipairs(Players:GetPlayers()) do
        if Plr~=LocalPlr and Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart") 
           and Plr.Character:FindFirstChild("Head") and Plr.Character:FindFirstChild("Humanoid") then
            local TRoot = Plr.Character.HumanoidRootPart
            local Dist = (Root.Position - TRoot.Position).Magnitude
            if Dist < MinDist and HasLineOfSight(Root.Position, TRoot.Position) then
                MinDist = Dist
                Best = Plr.Character
            end
        end
    end
    return Best
end

-- 🖍️ วงล็อกรอบเป้าหมาย
local function AttachRing(Tar)
    -- ล้างเก่า
    if Ring then Ring.Parent=nil end
    if RingConn then RingConn:Disconnect() end
    if not Tar then return end

    -- หาจุดยึดตามที่ต้องการ
    local function GetAimPos()
        if Settings.AimPriority=="Head" and Tar:FindFirstChild("Head") then
            return Tar.Head.Position
        end
        return Tar.HumanoidRootPart.Position
    end

    -- สร้างวง
    Ring = Instance.new("Part")
    Ring.Name = "LockRing"
    Ring.Shape = Enum.PartType.Cylinder
    Ring.Size = Vector3.new(0.2, 2.2, 2.2)
    Ring.Color = Settings.RingColor
    Ring.Material = Enum.Material.Neon
    Ring.Transparency = Settings.RingTrans
    Ring.Anchored = true
    Ring.CanCollide = false
    Ring.CastShadow = false
    Ring.Parent = Workspace

    -- ติดตาม+หมุนเสมอหันหน้ากล้อง
    RingConn = RunService.RenderStepped:Connect(function()
        if not Tar or not Tar:FindFirstChild("Humanoid") or Tar.Humanoid.Health<=0 or not Ring then
            RingConn:Disconnect()
            if Ring then Ring.Parent=nil end
            if CurrentTarget==Tar then
                CurrentTarget=nil; LockBtn.Text="❌ เป้าหมายหาย"
                task.delay(1,function() LockBtn.Text="🎯 ล็อกใกล้สุด" end)
            end
            return
        end
        local Pos = GetAimPos()
        Ring.CFrame = CFrame.new(Pos) * CFrame.Angles(math.rad(90), 0, 0) * CFrame.new(0, 0.25, 0)
        -- หมุนตามกล้องเพื่อให้เห็นวงชัดเจนเสมอ
        local CamDir = (Camera.CFrame.Position - Pos).Unit
        Ring.CFrame = CFrame.new(Pos, Pos + Vector3.new(CamDir.X,0,CamDir.Z)) * CFrame.Angles(math.rad(90),0,0) * CFrame.new(0,1.1,0)
    end)
end

-- ⚡ คำสั่งล็อกหลัก
local function ExecuteLock()
    if not Enabled then return end
    CurrentTarget = GetNearestPlayer()
    if CurrentTarget then
        LockBtn.Text = "✅ "..CurrentTarget.Name
        AttachRing(CurrentTarget)
        print("[LOCK] ->",CurrentTarget.Name,"| จุด:",Settings.AimPriority)
        return CurrentTarget
    else
        LockBtn.Text = "❌ ไม่เจอ/บดบัง"
        if Ring then Ring.Parent=nil end
        CurrentTarget=nil
        task.delay(1.3,function() LockBtn.Text="🎯 ล็อกใกล้สุด" end)
        return nil
    end
end

-- 🔗 เชื่อมปุ่มในเมนู+ปุ่มลัด
LockBtn.MouseButton1Click:Connect(ExecuteLock)
UIS.InputBegan:Connect(function(Input,Proc)
    if Proc then return end
    if Input.KeyCode == Settings.KeyBind then ExecuteLock() end
end)

